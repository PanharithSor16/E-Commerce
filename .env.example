# Copy to .env and replace every placeholder. Never commit .env.
# Generate secrets with e.g.:  openssl rand -base64 32

# ---- SQL Server (docker compose) ----
MSSQL_SA_PASSWORD=ChangeMe_Sa_Str0ng!Pass
DB_MIGRATOR_PASSWORD=ChangeMe_Migrator_Str0ng!1
DB_APP_PASSWORD=ChangeMe_App_Str0ng!1
# Loopback port for local DB tools (not exposed in the prod overlay)
DB_HOST_PORT=14333
# Use false with a managed database that presents a trusted certificate
DB_TRUST_SERVER_CERTIFICATE=true

# ---- Backend ----
# Public URL of the site (used in email links and the CORS allowlist)
APP_PUBLIC_BASE_URL=http://localhost
# 32+ random bytes, base64. Keys the HMAC of emails stored in login history.
APP_SECURITY_EMAIL_HASH_KEY=REPLACE_WITH_openssl_rand_base64_32
# First administrator, created on first start only if no admin exists. Remove after first boot.
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Admin-Passphrase
APP_REQUIRE_VERIFIED_EMAIL=true
# Swagger UI / OpenAPI in the prod profile (keep false on public deployments)
APP_API_DOCS_ENABLED=false
# Regex of reverse-proxy IPs whose X-Forwarded-For is trusted (default: Docker bridge range)
# APP_TRUSTED_PROXIES_REGEX=

# ---- Email (defaults to the bundled Mailpit) ----
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# ---- Payments: MOCK (development), STRIPE or PAYWAY (ABA PayWay) ----
PAYMENT_PROVIDER=MOCK
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ABA PayWay: merchant id and API key from ABA; the RSA public key (PEM) is only needed for refunds.
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_RSA_PUBLIC_KEY=
# Sandbox by default; production: https://checkout.payway.com.kh
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# Defaults to $APP_PUBLIC_BASE_URL/api/v1/payments/webhooks/payway (must be reachable by PayWay)
PAYWAY_CALLBACK_URL=
# Blank: customer picks on PayWay's page. Or one of cards, abapay_khqr, abapay_khqr_deeplink, wechat, alipay
PAYWAY_PAYMENT_OPTION=

# ---- Frontend (NEXT_PUBLIC_* are embedded in browser code: never put secrets here) ----
NEXT_PUBLIC_SITE_NAME=Shop
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Production overlay ----
HTTP_PORT=80
PUBLIC_HOSTNAME=shop.example.com
TLS_CERT_DIR=./infra/certs
